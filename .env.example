# =============================================================================
# Farah (فرة) environment file.
# Values below are the PRODUCTION defaults. Copy to .env, fill every "CHANGE" line,
# then run "php artisan key:generate" once and "php artisan farah:doctor".
# Never commit .env and never put real secrets in this example file.
# For a local machine: APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8020,
# CACHE_STORE=database, SESSION_DRIVER=database, SESSION_SECURE_COOKIE=false, MAIL_MAILER=log,
# OTP_DEV_CODE=1234 (see docs/DEPLOY.md).
# =============================================================================

APP_NAME=Farah
APP_ENV=production
# Generated by "php artisan key:generate". Changing it logs everyone out and breaks encrypted data.
APP_KEY=
# Old keys after a rotation (comma separated), so existing data can still be decrypted.
# APP_PREVIOUS_KEYS=
APP_DEBUG=false
# CHANGE: the public https:// address. Links in e-mails, signed URLs and CORS use it.
APP_URL=https://farah.example.sa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Logs: one file per day in storage/logs, kept LOG_DAILY_DAYS days ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL 8, utf8mb4) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farah
# CHANGE: a dedicated user with rights on this database only (not root).
DB_USERNAME=farah
DB_PASSWORD=

# --- Cache, sessions, queue: one server ---
# Redis (redis-server + php8.4-redis) for cache, rate limits, scheduler locks and sessions.
# Without Redis use "database" for both (works, slower under load; farah:doctor warns).
CACHE_STORE=redis
# CACHE_PREFIX=
SESSION_DRIVER=redis
QUEUE_CONNECTION=database
# Seconds before a job that is still running is handed to another worker. Keep above the worker --timeout.
DB_QUEUE_RETRY_AFTER=90

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Sessions and cookies (dashboards) ---
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS. Forced on in production by AppServiceProvider::harden() whatever is set here.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Uploads: "local" = storage/app/private (not reachable from the web). Code that needs public files
# (venue photos, logos) names the "public" disk itself.
FILESYSTEM_DISK=local

# --- E-mail (password resets, team invitations) ---
# CHANGE: the mailbox's SMTP details (Hostinger mail: smtp.hostinger.com, port 465, scheme smtps).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@farah.example.sa"
MAIL_FROM_NAME="${APP_NAME}"

# --- API for the mobile app ---
# Days before an app token expires, and the repeat-protection window in seconds (0 = off).
API_TOKEN_TTL_DAYS=90
API_DEDUPE_SECONDS=5
# Websites allowed to call the API from a browser, comma separated (the app is not a browser).
# Empty = only APP_URL itself.
CORS_ALLOWED_ORIGINS=
# Prefix on API tokens, so a leaked one is recognised by secret scanners.
SANCTUM_TOKEN_PREFIX=farah_

# --- Sign-in codes (OTP) ---
OTP_LENGTH=6
OTP_TTL_MINUTES=5
# Fixed development code. Only read when APP_ENV is local or testing; leave it commented on a server.
# OTP_DEV_CODE=1234

# --- Times: working hours and slots are wall-clock times here; the database stores UTC ---
FARAH_TIMEZONE=Asia/Riyadh

# --- Customer wallet: most an admin can add in one go, SAR ---
WALLET_MAX_GRANT=1000

# --- Integrations ---
# Payments: only the "fake" sandbox exists so far; no one is charged until a real gateway is added.
PAYMENT_DRIVER=fake
# CHANGE: a long random value (openssl rand -hex 32). "change-me" is refused outside local/testing.
PAYMENT_WEBHOOK_SECRET=change-me
# SMS: only "log" exists so far (codes are written to the log, not sent). Sender name for the real provider.
SMS_DRIVER=log
SMS_SENDER=FARAH
ACCOUNTING_DRIVER=null
# Push notifications: "log" or "fcm". For fcm, the absolute path of the Firebase service-account JSON,
# kept outside the project folder and readable by the web user only.
PUSH_DRIVER=log
FIREBASE_CREDENTIALS=

# --- Not used by default (S3 storage, if files ever move off the server) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
