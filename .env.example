APP_NAME=Farah
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8020

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Push notifications to the mobile app. Firebase: PUSH_DRIVER=fcm and the path of the service-account JSON.
PUSH_DRIVER=log
FIREBASE_CREDENTIALS=

# Sign-in codes: digits in a real code. OTP_DEV_CODE (below) must be empty on a real server.
OTP_LENGTH=6

# API: token life, repeat-protection window, and which websites may call the API from a browser (comma separated).
API_TOKEN_TTL_DAYS=90
API_DEDUPE_SECONDS=5
CORS_ALLOWED_ORIGINS=
# Prefix on API tokens, so a leaked one is recognised by secret scanners.
SANCTUM_TOKEN_PREFIX=farah_

# Integrations still on their stand-ins: SMS_DRIVER=log, ACCOUNTING_DRIVER=null
SMS_SENDER=FARAH
ACCOUNTING_DRIVER=null

# Times and "open now" are computed in this timezone.
FARAH_TIMEZONE=Asia/Riyadh

# Cookies only over HTTPS (forced on in production).
SESSION_SECURE_COOKIE=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Farah integrations (drivers: fake | real providers later)
PAYMENT_DRIVER=fake
PAYMENT_WEBHOOK_SECRET=change-me
SMS_DRIVER=log
WATHQ_DRIVER=fake
WATHQ_API_KEY=
OTP_TTL_MINUTES=5
OTP_DEV_CODE=1234
