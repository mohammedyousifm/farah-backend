{
    "preset": "laravel",
    "rules": {
        "no_unused_imports": true,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "single_quote": true,
        "trailing_comma_in_multiline": true,
        "no_superfluous_phpdoc_tags": false
    },
    "exclude": ["storage", "bootstrap/cache"]
}
